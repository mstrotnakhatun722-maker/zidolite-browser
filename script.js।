// অ্যাপটি পুরোপুরি লোড হওয়ার পর প্লাগইন সচল করার জন্য
document.addEventListener("deviceready", onDeviceReady, false);

function onDeviceReady() {
    console.log("Cordova is ready!");
    
    // ১. সার্চ বক্সে লিখে সার্চ করার লজিক
    // (নিশ্চিত করো তোমার HTML-এর সার্চ বক্সে id="searchInput" এবং বাটনে id="searchButton" আছে)
    var searchButton = document.getElementById("searchButton");
    if(searchButton) {
        searchButton.addEventListener("click", performSearch);
    }

    // ২. নিচের শর্টকাট বাটনগুলোতে ক্লিক করলে ওয়েবসাইট ওপেন হওয়ার লজিক
    setupShortcutButtons();
}

// সার্চ ইঞ্জিন অনুযায়ী সার্চ করার মেইন ফাংশন
function performSearch() {
    var query = document.getElementById("searchInput").value;
    // (নিশ্চিত করো তোমার HTML-এর ড্রপডাউনে id="searchEngineSelect" আছে)
    var engine = document.getElementById("searchEngineSelect") ? document.getElementById("searchEngineSelect").value : "Google";

    if (query.trim() !== "") {
        var searchUrl = "";
        if (engine === "Google" || engine === "google") {
            searchUrl = "https://google.com" + encodeURIComponent(query);
        } else if (engine === "Bing" || engine === "bing") {
            searchUrl = "https://bing.com" + encodeURIComponent(query);
        } else if (engine === "Yahoo" || engine === "yahoo") {
            searchUrl = "https://yahoo.com" + encodeURIComponent(query);
        } else {
            searchUrl = "https://google.com" + encodeURIComponent(query);
        }
        
        // অ্যাপের ভেতরেই সিকিউর ও প্রফেশনাল উপায়ে ওয়েবসাইট ওপেন করবে
        cordova.InAppBrowser.open(searchUrl, '_blank', 'location=no,toolbar=yes,clearcache=yes');
    }
}

// শর্টকাট বাটনগুলোর জন্য আলাদা ফাংশন
function setupShortcutButtons() {
    var shortcuts = {
        "btn-google": "https://google.com",
        "btn-youtube": "https://youtube.com",
        "btn-facebook": "https://facebook.com",
        "btn-wikipedia": "https://wikipedia.org",
        "btn-bing": "https://bing.com",
        "btn-yahoo": "https://yahoo.com"
    };

    // তোমার HTML কোডের বাটনের আইডি অনুযায়ী লিঙ্কগুলো অ্যাক্টিভ করবে
    Object.keys(shortcuts).forEach(function(id) {
        var btn = document.getElementById(id);
        if (btn) {
            btn.addEventListener("click", function() {
                cordova.InAppBrowser.open(shortcuts[id], '_blank', 'location=no,toolbar=yes');
            });
        }
    });
}
