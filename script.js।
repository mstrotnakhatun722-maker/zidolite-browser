<script>

/* ==========================================
   ZIDOLITE BROWSER
   CORDOVA INAPPBROWSER VERSION
========================================== */


/* ------------------------------------------
   GLOBAL STATE
------------------------------------------ */

let currentBrowser = null;

let engine =
    localStorage.getItem(
        "zidolite_engine"
    ) || "google";

let safeSearch =
    localStorage.getItem(
        "zidolite_safe_search"
    ) !== "off";


/* ------------------------------------------
   ENGINE NAME
------------------------------------------ */

function updateEngineName(){

    const names = {

        google: "Google",

        bing: "Bing",

        yahoo: "Yahoo",

        duck: "DuckDuckGo"

    };

    document.getElementById(
        "engineName"
    ).textContent =
        names[engine] || "Google";

}


/* ------------------------------------------
   SEARCH URL
------------------------------------------ */

function getSearchURL(text){

    const query =
        encodeURIComponent(text);


    if(engine === "bing"){

        return (
            "https://www.bing.com/search?q="
            + query
        );

    }


    if(engine === "yahoo"){

        return (
            "https://search.yahoo.com/search?p="
            + query
        );

    }


    if(engine === "duck"){

        return (
            "https://duckduckgo.com/?q="
            + query
        );

    }


    /*
       DEFAULT = GOOGLE
    */

    return (
        "https://www.google.com/search?q="
        + query
    );

}


/* ------------------------------------------
   OPEN WEBSITE
------------------------------------------ */

function openWebsite(url){

    if(!url){
        return;
    }


    /*
       Make sure Cordova is ready.
    */

    if(
        typeof cordova === "undefined" ||
        !window.cordova
    ){

        /*
           Browser fallback for testing
           outside Cordova.
        */

        window.location.href = url;

        return;

    }


    /*
       Close previous InAppBrowser.
    */

    if(currentBrowser){

        try{
            currentBrowser.close();
        }catch(e){}

        currentBrowser = null;

    }


    /*
       Open website inside the app.

       IMPORTANT:

       _blank here is the Cordova
       InAppBrowser target.

       This is NOT an HTML
       target="_blank" link.
    */

    currentBrowser =
        window.open(
            url,
            "_blank",
            "location=yes," +
            "toolbar=yes," +
            "zoom=no," +
            "hardwareback=yes," +
            "hideurlbar=no"
        );


    if(!currentBrowser){

        alert(
            "Unable to open the website. " +
            "Please make sure Cordova " +
            "InAppBrowser is installed."
        );

        return;

    }


    /*
       When the InAppBrowser closes.
    */

    currentBrowser.addEventListener(
        "exit",
        function(){

            currentBrowser = null;

        }
    );


    /*
       Update address field.
    */

    document.getElementById(
        "address"
    ).value = url;


    /*
       Save history.
    */

    saveHistory(url);

}


/* ------------------------------------------
   SEARCH
------------------------------------------ */

function searchWeb(){

    const input =
        document.getElementById(
            "query"
        );

    const text =
        input.value.trim();


    if(!text){
        return;
    }


    let url;


    /*
       Direct URL
    */

    if(
        text.indexOf(
            "https://"
        ) === 0 ||

        text.indexOf(
            "http://"
        ) === 0
    ){

        url = text;

    }

    /*
       Search query
    */

    else{

        url =
            getSearchURL(text);

    }


    openWebsite(url);

}


/* ------------------------------------------
   SEARCH ENTER
------------------------------------------ */

function searchEnter(event){

    if(event.key === "Enter"){

        searchWeb();

    }

}


/* ------------------------------------------
   ADDRESS BAR
------------------------------------------ */

function addressEnter(event){

    if(event.key !== "Enter"){
        return;
    }


    const input =
        document.getElementById(
            "address"
        );

    const text =
        input.value.trim();


    if(!text){
        return;
    }


    if(
        text.indexOf(
            "https://"
        ) === 0 ||

        text.indexOf(
            "http://"
        ) === 0
    ){

        openWebsite(text);

    }

    else{

        openWebsite(
            getSearchURL(text)
        );

    }

}


/* ------------------------------------------
   ENGINE MENU
------------------------------------------ */

function toggleEngineMenu(){

    const menu =
        document.getElementById(
            "engineMenu"
        );


    if(
        menu.style.display === "block"
    ){

        menu.style.display = "none";

    }

    else{

        menu.style.display = "block";

    }

}


/* ------------------------------------------
   SELECT ENGINE
------------------------------------------ */

function selectEngine(value){

    engine = value;


    localStorage.setItem(
        "zidolite_engine",
        value
    );


    updateEngineName();


    document.getElementById(
        "engineMenu"
    ).style.display = "none";

}


/* ------------------------------------------
   INAPPBROWSER BACK
------------------------------------------ */

function inAppBack(){

    if(!currentBrowser){

        return;

    }


    try{

        currentBrowser.executeScript(
            {
                code:
                    "history.back();"
            },
            function(){}

        );

    }catch(e){}

}


/* ------------------------------------------
   INAPPBROWSER FORWARD
------------------------------------------ */

function inAppForward(){

    if(!currentBrowser){

        return;

    }


    try{

        currentBrowser.executeScript(
            {
                code:
                    "history.forward();"
            },
            function(){}

        );

    }catch(e){}

}


/* ------------------------------------------
   INAPPBROWSER RELOAD
------------------------------------------ */

function inAppReload(){

    if(!currentBrowser){

        return;

    }


    try{

        currentBrowser.executeScript(
            {
                code:
                    "location.reload();"
            },
            function(){}

        );

    }catch(e){}

}


/* ------------------------------------------
   HOME
------------------------------------------ */

function goHome(){

    if(currentBrowser){

        try{
            currentBrowser.close();
        }catch(e){}

        currentBrowser = null;

    }

}


/* ------------------------------------------
   NEW TAB
------------------------------------------ */

function newTab(){

    /*
       In this first version,
       a new tab means opening a fresh
       InAppBrowser session.
    */

    openWebsite(
        "https://www.google.com"
    );

}


/* ------------------------------------------
   SETTINGS
------------------------------------------ */

function toggleSettings(){

    const panel =
        document.getElementById(
            "settings"
        );


    if(
        panel.style.display === "block"
    ){

        panel.style.display = "none";

    }

    else{

        panel.style.display = "block";

    }

}


/* ------------------------------------------
   DARK MODE
------------------------------------------ */

function toggleDarkMode(){

    document.body.classList.toggle(
        "dark"
    );


    localStorage.setItem(
        "zidolite_dark",
        document.body.classList.contains(
            "dark"
        )
        ? "on"
        : "off"
    );

}


/* ------------------------------------------
   SAFE SEARCH
------------------------------------------ */

function toggleSafeSearch(){

    safeSearch = !safeSearch;


    localStorage.setItem(
        "zidolite_safe_search",
        safeSearch
        ? "on"
        : "off"
    );


    document.getElementById(
        "safeSearchText"
    ).textContent =
        safeSearch ? "ON" : "OFF";

}


/* ------------------------------------------
   HISTORY
------------------------------------------ */

function saveHistory(url){

    let history;


    try{

        history =
            JSON.parse(
                localStorage.getItem(
                    "zidolite_history"
                ) || "[]"
            );

    }catch(e){

        history = [];

    }


    history.unshift(url);


    /*
       Remove duplicates.
    */

    history =
        [...new Set(history)];


    /*
       Keep last 200 entries.
    */

    history =
        history.slice(0,200);


    localStorage.setItem(
        "zidolite_history",
        JSON.stringify(history)
    );

}


function clearHistory(){

    localStorage.removeItem(
        "zidolite_history"
    );


    alert(
        "Browsing history cleared."
    );

}


/* ------------------------------------------
   DOWNLOADS
------------------------------------------ */

function showDownloads(){

    alert(
        "Downloads will be handled by " +
        "the Cordova Android download layer."
    );

}


/* ------------------------------------------
   GOOGLE LOGIN
------------------------------------------ */

function login(){

    alert(
        "Google account login will be " +
        "connected through a secure OAuth " +
        "implementation."
    );

}


func
